    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
